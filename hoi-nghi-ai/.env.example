# ============================================================================
#  Cấu hình mẫu — sao chép thành .env rồi điền giá trị thật.
#  KHÔNG đưa file .env thật lên Git.
# ============================================================================

# --- Cơ sở dữ liệu -----------------------------------------------------------
DATABASE_URL=sqlite:///./hoi_nghi_ai.db
# Ví dụ MySQL: mysql+pymysql://hoinghi:matkhau@localhost:3306/hoi_nghi_ai

# --- Xác thực ----------------------------------------------------------------
SECRET_KEY=thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Nhà cung cấp AI: mock | gemini | openai | ollama ------------------------
AI_PROVIDER=mock
AI_MODEL=gemini-2.0-flash
AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Tham số kiểm soát gọi AI ------------------------------------------------
AI_TEMPERATURE=0.3
AI_MAX_OUTPUT_TOKENS=900
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_MAX_INPUT_CHARS=6000
AI_RATE_LIMIT_PER_HOUR=60

# --- Tài khoản ban tổ chức khởi tạo -----------------------------------------
ADMIN_EMAIL=organizer@hoinghi.vn
ADMIN_PASSWORD=organizer123
